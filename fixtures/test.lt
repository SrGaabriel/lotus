@[lang "type.bool"]
inductive Boolean : Type :=
      True : Boolean
    | False : Boolean;

@[lang "type.unit"]
inductive Unit : Type :=
    @[lang "constructor.unit"]
    MkUnit : Unit;

@[lang "type.int32"]
inductive Int32 : Type := MkInt32 (val : Int) : Int32;

def hello : Boolean := {}

def hello_world (hello : Boolean) (world : Boolean) : Boolean := {}

def foo : Boolean := Boolean::True

def world : Boolean := 5

def stmts : Boolean := {
    let x := 5;
    let y := 10;
    x := 10;
}