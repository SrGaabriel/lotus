import ind;
import ind::[fn];
import ind::hello::[fn,namespace::[ola],world];

inductive Nat : Type :=
      Zero : Nat
    | Succ : Nat -> Nat;

inductive List : Nat -> Type -> Type :=
      Nil {a : Type} : List Nat::Zero a
    | Cons {a : Type} : a -> List n a -> List (Nat::Succ n) a;

@[lang "type.bool"]
inductive Boolean : Type :=
      True : Boolean
    | False : Boolean;

@[lang "type.unit"]
inductive Unit : Type :=
    @[lang "constructor.unit"]
    MkUnit : Unit;

@[lang "type.int32"]
inductive Int32 : Type := MkInt32 (val : Int) : Int32;

def hello_world (hello : Boolean) (world : Boolean) : Unit := {}

def foo : Boolean := Boolean::True

def stmts : Int32 := {
    let x : Int32 := 5;
    let y : Int32 := 10;
    x := 10;
    let hello := hello_world Boolean::True Boolean::False;
    return x;
}

def stmts2 (test : Int32) : Int32 := {
    let x := 5;
    let y := 10;
    x := 10;
    return test;
}

def id (test : h) : h := test

def test_mutation : Unit := {
    let natural := Nat::Succ (Nat::Succ Nat::Zero);
    let list : List natural Int32 := List::Cons 1 (List::Cons 2 (List::Nil));
    let x := id 5;
    let natural := Nat::Succ (Nat::Succ Nat::Zero);
    x := 10;
}

def weird_number : Int32 := 0xDEADBEEF

def weird_number2 : Int32 := 0b10101010

def weird_number3 : Int32 := 0o1234567

def weird_number4 : Int32 := 00123

def weird_number5 : Int32 := 123_456_789

def weird_number6 : Int32 := 5e2

def weirdest_number : Int32 := 0xDEAD_BEEF

def weirdest_number2 : Int32 := 0.1e1f32