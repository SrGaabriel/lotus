@[lang "type.bool"]
inductive Boolean : Type :=
      True : Boolean
    | False : Boolean;

@[lang "type.unit"]
inductive Unit : Type :=
    @[lang "constructor.unit"]
    MkUnit : Unit;

@[lang "type.int32"]
inductive Int32 : Type := MkInt32 (val : Int) : Int32;

def hello_world (hello : Boolean) (world : Boolean) : Unit := {}

def foo : Boolean := Boolean::True

def stmts : Int32 := {
    let x : Int32 := 5;
    let y : Int32 := 10;
    x := 10;
    let hello := hello_world Boolean::True Boolean::False;
    return x;
}

def stmts2 (test : Int32) : Int32 := {
    let x := 5;
    let y := 10;
    x := 10;
    return test;
}

def id (test : h) : h := test