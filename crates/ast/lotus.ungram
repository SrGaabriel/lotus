SourceFile =
  Decl*

Decl =
  DefDecl

DefDecl =
  'def' name:Name params:Binder* ':' return_type:Type ':=' body:Expr

Expr =
  ParenExpr | BraceBlock | Literal | Name

ParenExpr =
  '(' Expr ')'

BraceBlock =
  '{' Stmt* '}'

Stmt =
  LetStmt | MutationStmt

LetStmt =
  'let' name:Name ':=' expr:Expr ';'

MutationStmt =
  name:Name ':=' expr:Expr ';'

Literal =
  NumberLit | StringLit

Binder =
  ParenBinder | BraceBinder | BracketBinder

ParenBinder =
  '(' name:Name ':' type:Type ')'

BraceBinder =
  '{' name:Name ':' type:Type '}'

BracketBinder =
  '[' name:Name ':' type:Type ']'

Type =
  Name

Name =
  'ident'

NumberLit =
  'number_lit'

StringLit =
  'string_lit'
