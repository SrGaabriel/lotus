SourceFile =
  Decl*

Decl =
  DefDecl | InductiveDecl

DefDecl =
  Attribute* 'def' ident:Identifier params:Binder* return_type:ReturnType ':=' body:Expr

InductiveDecl =
  Attribute* 'inductive' ident:Identifier params:Binder* return_type:ReturnType ':=' InductiveConstructors ';'

InductiveConstructors =
  ConstructorDecl ('|' ConstructorDecl)*

ConstructorDecl =
  ident:Identifier params:Binder* return_type:ReturnType

ReturnType =
  ':' Type

Expr =
  ParenExpr | BraceBlock | Literal | Name

ParenExpr =
  '(' Expr ')'

BraceBlock =
  '{' Stmt* '}'

Stmt =
  LetStmt | MutationStmt

LetStmt =
  'let' name:Identifier ':=' expr:Expr ';'

MutationStmt =
  name:Identifier ':=' expr:Expr ';'

Literal =
  NumberLit | StringLit

Binder =
  ParenBinder | BraceBinder | BracketBinder

ParenBinder =
  '(' name:Identifier ':' type:Type ')'

BraceBinder =
  '{' name:Identifier ':' type:Type '}'

BracketBinder =
  '[' name:Identifier ':' type:Type ']'

Type =
  Name | PiType

PiType =
  params:Binder* '->' return_type:Type

Name =
  path:PathSegment* member:Identifier

PathSegment =
  '::' Identifier

Identifier =
  'ident'

NumberLit =
  'number_lit'

StringLit =
  'string_lit'

Attribute =
  '@' '[' Identifier Literal? ']'