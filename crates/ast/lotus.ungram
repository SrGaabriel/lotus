SourceFile =
  Decl*

Decl =
  DefDecl | InductiveDecl

DefDecl =
  Attribute* 'def' ident:Identifier binders:Binder* return_type:ReturnType ':=' body:Expr

InductiveDecl =
  Attribute* 'inductive' ident:Identifier binders:Binder* return_type:ReturnType ':=' InductiveConstructors ';'

InductiveConstructors =
  ConstructorDecl ('|' ConstructorDecl)*

ConstructorDecl =
  Attribute* ident:Identifier binders:Binder* return_type:ReturnType

ReturnType =
  ':' Type

Expr =
  ParenExpr | BraceBlock | Literal | Name | AppExpr

AppExpr =
  func:Expr arg:Expr

ParenExpr =
  '(' Expr ')'

BraceBlock =
  '{' Stmt* '}'

Stmt =
  LetStmt | MutationStmt | ReturnStmt

LetStmt =
  'let' name:Identifier TypeAnnotation? ':=' expr:Expr ';'

TypeAnnotation = 
  ':' Type

MutationStmt =
  name:Identifier ':=' expr:Expr ';'

ReturnStmt =
  'return' expr:Expr ';'

Literal =
  NumberLit | StringLit

Binder =
  ParenBinder | BraceBinder | BracketBinder

ParenBinder =
  '(' name:Identifier ':' type:Type ')'

BraceBinder =
  '{' name:Identifier ':' type:Type '}'

BracketBinder =
  '[' name:Identifier ':' type:Type ']'

Type =
  Name | PiType | AppType

AppType =
  func:Type arg:Type

PiType =
  params:Binder* '->' return_type:Type

Name =
  path:PathSegment* member:Identifier

PathSegment =
  '::' Identifier

Identifier =
  'ident'

NumberLit =
  'number_lit'

StringLit =
  'string_lit'

Attribute =
  '@' '[' Identifier AttributeValue? ']'

AttributeValue =
  StringLit | NumberLit